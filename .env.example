# Puertos del host.
# En el VPS te van a asignar dos puertos (por ejemplo 5007 y 8087).
API_PORT=5007
ADMIN_PORT=8087

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=admin
# Usar una contraseña sin ";" ni espacios.
POSTGRES_PASSWORD=cambiar_esta_clave

# Host del PostgreSQL al que se conecta la API.
# Local: postgres_db (el contenedor del override local).
# VPS: el host que indique el profesor (IP, nombre de contenedor
#      o host.docker.internal si está en el host del VPS).
DB_HOST=postgres_db
DB_INTERNAL_PORT=5432

# Puerto del host para inspeccionar la base en local
# (solo con docker-compose.local.yml). Se usa 5433 para no chocar
# con un PostgreSQL instalado en el host (5432).
DB_PORT=5433

# API
ASPNETCORE_ENVIRONMENT=Production
ENABLE_DETAILED_LOGS=false
DATABASE_TIMEOUT=30
